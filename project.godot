; Engine configuration file.
; Godot 4.3+ project format. Authored for the 4.3 feature set and
; checked with Godot 4.7. GL Compatibility is the Pi 5 renderer.

config_version=5

[application]

config/name="NOVA"
config/description="Letterbox telemetry display for a Raspberry Pi 5 driving a 1920x480 HDMI panel."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.070588, 0.070588, 0.070588, 1)
boot_splash/show_image=false
run/low_processor_mode=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=480
window/size/initial_position_type=1
window/size/window_width_override=1920
window/size/window_height_override=480
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="fractional"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.070588, 0.070588, 0.070588, 1)
textures/vram_compression/import_etc2_astc=true
